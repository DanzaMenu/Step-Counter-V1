<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1220"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="#DDFFFFFF" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Step History"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#F0F0F0"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="24dp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvSummary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#80FFFFFF"
        android:paddingHorizontal="24dp"
        android:layout_marginBottom="16dp" />

    <!-- Tab bar: Day / Week / Month / Year -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/bg_settings_section"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabIndicatorColor="#6C9BF2"
        app:tabIndicatorHeight="3dp"
        app:tabIndicatorFullWidth="false"
        app:tabSelectedTextColor="#E0E0E0"
        app:tabTextColor="#66FFFFFF"
        app:tabRippleColor="#226C9BF2" />

    <!-- List of entries -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="16dp" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="No step data yet.\nKeep walking!"
        android:textSize="16sp"
        android:textColor="#55FFFFFF"
        android:visibility="gone" />

</LinearLayout>
