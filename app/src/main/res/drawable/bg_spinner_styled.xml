<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#18FFFFFF" />
        </shape>
    </item>
    <item android:gravity="end|center_vertical" android:right="12dp"
        android:width="12dp" android:height="12dp">
        <rotate android:fromDegrees="45" android:pivotX="50%" android:pivotY="35%">
            <shape android:shape="rectangle">
                <size android:width="8dp" android:height="8dp" />
                <solid android:color="#55FFFFFF" />
            </shape>
        </rotate>
    </item>
</layer-list>
